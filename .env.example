POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=payment_system
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis (M1+: JWT access-token denylist on logout)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (M1). Generate a secret with, e.g.:
#   openssl rand -base64 64
# Must decode to at least 256 bits for HS256. Never commit a real value.
JWT_SECRET=
JWT_ACCESS_TTL=PT15M
REFRESH_TOKEN_TTL=P7D
