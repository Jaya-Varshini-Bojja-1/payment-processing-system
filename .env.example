# Copy to `.env` (git-ignored) or export these in your shell before starting
# the app. Spring Boot does NOT read a .env file by itself: the values must be
# present as OS environment variables (or loaded by your IDE run configuration).
# Every variable below maps to a ${...} placeholder in
# src/main/resources/application.yml. Never commit real credentials.
#
# REQUIRED (no default in application.yml; the app will not start without them):
#   POSTGRES_USER, POSTGRES_PASSWORD, JWT_SECRET
# Everything else has the default shown and can be left out.

# --- PostgreSQL (host-local, Flyway migrations run on startup) ---------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=payment_system
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Redis (JWT denylist, idempotency cache, rate limiting) ------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ----------------------------------------------------------------------
# Base64-encoded key that decodes to at least 256 bits (HS256). Generate your
# own, e.g.:  openssl rand -base64 64
JWT_SECRET=
# ISO-8601 durations
JWT_ACCESS_TTL=PT15M
REFRESH_TOKEN_TTL=P7D

# --- Kafka (KRaft, no ZooKeeper; topics auto-create on startup) ---------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TRANSFERS_COMPLETED_TOPIC=transfers.completed
TRANSFERS_DLQ_TOPIC=transfers.dlq
PAYMENTS_PROCESS_TOPIC=payments.process
PAYMENTS_DLQ_TOPIC=payments.dlq

# =============================================================================
# Optional tuning (defaults shown; uncomment only to override)
# =============================================================================

# --- Idempotency / transfers ---------------------------------------------------
# TTL of the Redis fast-path cache; PostgreSQL remains the source of truth.
# IDEMPOTENCY_REDIS_TTL=P1D
# Bounded optimistic-lock retries for a transfer before returning 409.
# TRANSFER_MAX_LOCK_ATTEMPTS=3

# --- Rate limiting (per user, per money-moving POST endpoint) -----------------
# Fails open if Redis is unreachable.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX_REQUESTS=20
# RATE_LIMIT_WINDOW=PT1M

# --- Outbox publisher and consumer ---------------------------------------------
# OUTBOX_PUBLISHER_ENABLED=true
# OUTBOX_SCHEDULER_ENABLED=true
# OUTBOX_PUBLISH_BATCH_SIZE=20
# OUTBOX_POLL_INTERVAL_MS=2000
# OUTBOX_MAX_ATTEMPTS=5
# OUTBOX_INITIAL_BACKOFF=PT1S
# OUTBOX_BACKOFF_MULTIPLIER=2.0
# OUTBOX_PUBLISH_TIMEOUT=PT5S
# OUTBOX_STALE_PUBLISHING_TIMEOUT=PT1M
# OUTBOX_CONSUMER_MAX_ATTEMPTS=3
# OUTBOX_CONSUMER_RETRY_BACKOFF=PT0.5S

# --- Payment processing (deposit / withdrawal retries) -------------------------
# PAYMENT_MAX_GATEWAY_ATTEMPTS=3
# PAYMENT_RETRY_INITIAL_BACKOFF=PT2S
# PAYMENT_RETRY_BACKOFF_MULTIPLIER=2.0

# --- Simulated gateway (amountPaise % 100 selects the demo scenario) -----------
# [0, SUCCESS) succeeds; [SUCCESS, RETRY_SUCCEEDS) fails once then succeeds;
# [RETRY_SUCCEEDS, NON_RETRYABLE) always fails retryably (manual review);
# [NON_RETRYABLE, 100) is a permanent decline.
# GATEWAY_SUCCESS_UPPER_BOUND=80
# GATEWAY_RETRY_SUCCEEDS_UPPER_BOUND=90
# GATEWAY_NON_RETRYABLE_UPPER_BOUND=95
