		{
			"name": "04 Rate limit (optional)",
			"description": "OPTIONAL and independent of the demo above. Requires `01 Happy path` to have run (needs Bob's token) and `app.rate-limit.enabled=true` (default). Fires 25 rapid withdrawal requests as Bob, each with a fresh Idempotency-Key and an amount far above his balance (so no money can ever move). The limit is 20 per minute per user per endpoint (default), so the later requests get `429` with a `Retry-After` header. This only throttles Bob's *withdrawal* endpoint for up to a minute; transfers and deposits use separate counters.",
			"item": [
				{
					"name": "4.01 Burst of 25 withdrawals -> 429 after the limit",
					"event": [
						{ "listen": "test", "script": { "type": "text/javascript", "exec": [
							"const base = pm.variables.get('baseUrl');",
							"const token = pm.collectionVariables.get('bobToken');",
							"const TOTAL = 25;",
							"const statuses = [pm.response.code];",
							"let retryAfter = pm.response.code === 429 ? pm.response.headers.get('Retry-After') : null;",
							"",
							"function fire(i) {",
							"  if (i >= TOTAL) { finish(); return; }",
							"  pm.sendRequest({",
							"    url: base + '/api/v1/payments/withdrawals',",
							"    method: 'POST',",
							"    header: {",
							"      'Authorization': 'Bearer ' + token,",
							"      'Content-Type': 'application/json',",
							"      'Idempotency-Key': pm.variables.replaceIn('{{$guid}}')",
							"    },",
							"    body: { mode: 'raw', raw: JSON.stringify({ amountPaise: 999999999 }) }",
							"  }, function (err, res) {",
							"    if (err) { statuses.push('error'); }",
							"    else {",
							"      statuses.push(res.code);",
							"      if (res.code === 429 && !retryAfter) { retryAfter = res.headers.get('Retry-After'); }",
							"    }",
							"    fire(i + 1);",
							"  });",
							"}",
							"",
							"function finish() {",
							"  console.log('Statuses: ' + statuses.join(','));",
							"  pm.test('Early requests are processed normally (400 insufficient balance)', () => pm.expect(statuses[0] === 400 || statuses[0] === 429).to.be.true);",
							"  pm.test('At least one request was rate limited (429)', () => pm.expect(statuses).to.include(429));",
							"  pm.test('429 responses carry Retry-After', () => pm.expect(Number(retryAfter)).to.be.above(0));",
							"}",
							"",
							"fire(1);"
						] } }
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{bobToken}}", "type": "string" } ] },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Idempotency-Key", "value": "{{$guid}}" }
						],
						"body": { "mode": "raw", "raw": "{\n  \"amountPaise\": 999999999\n}", "options": { "raw": { "language": "json" } } },
						"url": "{{baseUrl}}/api/v1/payments/withdrawals"
					}
				}
			]
		}
