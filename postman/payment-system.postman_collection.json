				{
					"name": "1.14 Alice's ledger (CREDIT deposit, DEBIT transfer)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const entries = pm.response.json().content;",
									"pm.test('Exactly two ledger lines so far', () => pm.expect(entries.length).to.eql(2));",
									"const signed = entries.reduce((sum, e) => sum + (e.entryType === 'CREDIT' ? 1 : -1) * e.amount.amountPaise, 0);",
									"const expected = Number(pm.variables.get('depositAmountPaise')) - Number(pm.variables.get('transferAmountPaise'));",
									"pm.test('Signed ledger sum equals the materialized balance', () => pm.expect(signed).to.eql(expected));",
									"pm.test('Newest entry is the transfer DEBIT', () => pm.expect(entries[0].entryType).to.eql('DEBIT'));"
								]
							}
						}
					],
					"request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/accounts/{{aliceAccountId}}/ledger?page=0&size=20" }
				},
