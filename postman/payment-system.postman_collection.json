				{
					"name": "1.07 Deposit into Alice's account (async, 202)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Client-generated idempotency key; kept so the negative folder can replay it.",
									"pm.collectionVariables.set('depositKey', pm.variables.replaceIn('{{$guid}}'));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 202 Accepted', () => pm.response.to.have.status(202));",
									"const body = pm.response.json();",
									"pm.test('A DEPOSIT payment was accepted for the configured amount', () => {",
									"  pm.expect(body.type).to.eql('DEPOSIT');",
									"  pm.expect(body.amount.amountPaise).to.eql(Number(pm.variables.get('depositAmountPaise')));",
									"});",
									"pm.test('Not settled yet (no ledger post before the gateway succeeds)', () => {",
									"  pm.expect(['PENDING', 'PROCESSING', 'RETRYING', 'SUCCEEDED']).to.include(body.status);",
									"});",
									"pm.collectionVariables.set('depositPaymentId', body.id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Idempotency-Key", "value": "{{depositKey}}" }
						],
						"body": { "mode": "raw", "raw": "{\n  \"amountPaise\": {{depositAmountPaise}}\n}", "options": { "raw": { "language": "json" } } },
						"url": "{{baseUrl}}/api/v1/payments/deposits"
					}
				},
				{
					"name": "1.08 Poll deposit until SUCCEEDED",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Give the outbox publisher / Kafka consumer a moment between polls.",
									"if (Number(pm.collectionVariables.get('pollAttempts') || 0) > 0) { setTimeout(function () {}, 1500); }"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const EXPECTED = 'SUCCEEDED';",
									"const MAX_ATTEMPTS = 30;",
									"const TERMINAL = ['SUCCEEDED', 'FAILED', 'REQUIRES_MANUAL_REVIEW'];",
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const status = pm.response.json().status;",
									"const attempts = Number(pm.collectionVariables.get('pollAttempts') || 0) + 1;",
									"if (!TERMINAL.includes(status) && attempts < MAX_ATTEMPTS) {",
									"  pm.collectionVariables.set('pollAttempts', attempts);",
									"  postman.setNextRequest(pm.info.requestName);",
									"} else {",
									"  pm.collectionVariables.unset('pollAttempts');",
									"  pm.test('Payment reached ' + EXPECTED, () => pm.expect(status).to.eql(EXPECTED));",
									"  pm.test('Gateway reference recorded', () => pm.expect(pm.response.json().gatewayReference).to.be.a('string').and.not.empty);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/api/v1/payments/{{depositPaymentId}}"
					}
				},
